author: "harness:codex"
estimated_minutes: 180
acceptance_criteria: "The complete raw manifest returns compatible true with zero SDK findings at pm 2026.8.20; the inert key is removed only after the real extension capabilities are regression-tested; development uses an exact 2026.8.20 pm CLI/SDK pin and the peer/manifest floor is 2026.8.20; npm and Bun installed-package acceptance plus release:check pass"
reviewer: "harness:codex"
risk: medium
