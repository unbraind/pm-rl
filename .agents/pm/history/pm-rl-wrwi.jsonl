{"ts":"2026-08-26T22:31:56.272Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_instance":"66f51baccd944ab11404f28c","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null},"op":"tests_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-26T22:31:56.272Z"},{"op":"add","path":"/metadata/tests","value":[{"command":"npx tsx --test --test-name-pattern=\"gate result names are trimmed at the parse boundary\" test/gatesim.test.ts","path":"test/gatesim.test.ts","scope":"project","note":"round-6: gate name trimmed at the parse boundary"},{"command":"npx tsx --test --test-name-pattern=\"refuses unquoted assigned-secret assignments\" test/gatesim.test.ts","path":"test/gatesim.test.ts","scope":"project","note":"round-6: unquoted secrets refused"},{"command":"npx tsx --test --test-name-pattern=\"accepts TypeScript type annotations\" test/gatesim.test.ts","path":"test/gatesim.test.ts","scope":"project","note":"round-7: token colon string is not a credential"},{"command":"npx tsx --test --test-name-pattern=\"refuse with the episode code prefix\" test/gatesim.test.ts","path":"test/gatesim.test.ts","scope":"project","note":"round-7: episode body refuses with invalid_episode_"},{"command":"npx tsx --test --test-name-pattern=\"expands the declared space into child runs\" test/sweep.test.ts","path":"test/sweep.test.ts","scope":"project","note":"round-6: sweep reports the host-resolved id"},{"command":"npx tsx --test --test-name-pattern=\"__proto__ dimension survives as an own key\" test/sweep.test.ts","path":"test/sweep.test.ts","scope":"project","note":"round-7: __proto__ dimension is not silently dropped"},{"command":"npx tsx --test --test-name-pattern=\"links both environment versions\" test/transfer.test.ts","path":"test/transfer.test.ts","scope":"project","note":"round-6: transfer edge sources are named constants"}]}],"before_hash":"86a552e3ee54eb5b4839c9584