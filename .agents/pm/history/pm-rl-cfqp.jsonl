{"ts":"2026-08-31T16:38:41.769Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"1ef48f23db41a22d982ce761","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-rl-cfqp"},{"op":"add","path":"/metadata/title","value":"Converge the pinned pm-cli on 2026.8.31 and repair history hashes"},{"op":"add","path":"/metadata/description","value":"Converge the fleet on @unbrained/pm-cli 2026.8.31. pm-cli changed its history-hash computation between 2026.8.22 and 2026.8.24, so a repo whose history was written by an older pm reports history_drift_chain_mismatch when the pinned binary is bumped (upstream pm-cli#1168). The history is not corrupt; history-repair recomputes the hash fields under the new binary. The whole fleet converges on 2026.8.31 so every repo agrees."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T16:38:41.769Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T16:38:41.769Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"49742db622538b88e8aa68da642578c1efe8ad3e0e87894895f6cc512c4ccbfa","item_hash_version":3,"message":""}
