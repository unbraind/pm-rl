{"ts":"2026-08-31T16:37:04.227Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"1ef48f23db41a22d982ce761","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-rl-niml"},{"op":"add","path":"/metadata/title","value":"Allow dependabot[bot] through the git identity audit"},{"op":"add","path":"/metadata/description","value":"The physical git identity audit inspects every object in the database, including the unreachable commit objects a Dependabot pull request introduces into a CI checkout. Dependabot authors commits as 49699333+dependabot[bot]@users.noreply.github.com, which was absent from the approved list, so every Dependabot PR failed the Audit commit identities step. The gate's purpose -- keeping machine-local developer identities out of the history -- is preserved by adding the exact Dependabot noreply address rather than a wildcard, so an unknown human identity is still rejected."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T16:37:04.227Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T16:37:04.227Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"6b9dea1af4ee4409134532cd6ba872842f81f98ccf4ac633bda46c466925b73b","item_hash_version":3,"message":""}
{"ts":"2026-08-31T16:37:24.191Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"1ef48f23db41a22d982ce761","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-31T16:37:24.191Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-31T16:37:24.191Z","author":"pi-agent","text":"Added 49699333+dependabot[bot]@users.noreply.github.com to .github/approved-git-identities.txt with a comment explaining the exact-address choice. Added two tests against the real allowlist: one approves a genuine dependabot[bot] commit (goes red if the entry is reverted), one rejects an unknown human identity (stays green with and without the entry, pins the gate against weakening). Verified the revert test fails without the fix: rejected 4***@users.noreply.github.com. Verified the audit now approves 4 unique addresses on main (was rejecting 1)."}]}],"before_hash":"6b9dea1af4ee4409134532cd6ba872842f81f98ccf4ac633bda46c466925b73b","after_hash":"16bcce530eef61f7fc5aa8d9ddc9fa0e98006cbb2fd112301dcb450131eb067e","item_hash_version":3}
