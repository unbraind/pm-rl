{"hash_algorithm":"sha256","ts":"2026-10-21T16:53:13.328Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"5d9cc3776c9633656a5e1057","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"xhigh","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-rl-baseline"},{"op":"add","path":"/metadata/title","value":"Beat the constant baseline with item-paired recursive promotion gates"},{"op":"add","path":"/metadata/description","value":"Build on PR #94 with a bounded title-feature learner, held-out item confidence intervals against incumbent and constants, and at least three measured recursive proposal attempts on the same public corpus. Preserve contamination, approvals, resource accounting, resume and cancellation. Report refusals honestly."},{"op":"add","path":"/metadata/type","value":"Task"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-21T16:53:13.328Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-21T16:53:13.328Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"},{"op":"add","path":"/metadata/parent","value":"pm-rl-apvf"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"572e41dfc2e0c9ebd8da594aca60b1e772283a89062a00a54457980817b4bee1","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substant