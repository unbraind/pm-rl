{"ts":"2026-08-27T21:07:33.773Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"e7e0dae4659b639448bc8b15","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-27T21:07:33.773Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-27T21:07:33.773Z","author":"pi-agent","text":"Measured: locally readFileSync(0) on fd 0 (a socket under node --test) throws EAGAIN; on a CI pipe at EOF it returns empty string. The logRun stdin test therefore took the catch branch locally and the try-succeed branch on CI. Fixed by extracting readStdin() with an injectable read parameter: EAGAIN is treated as empty input so both environments take the same path. Three new tests cover the success, EAGAIN, and non-EAGAIN error branches deterministically. npm run coverage exits 0 with 17 files at 100/100/100."}]}],"before_hash":"a58e00055dbda74fdf0ce07f0194b56f123b3114d8088398b35650a6565be19e","after_hash":"eb2c7714fba113d12dbbd9ce9d3f475db1aad6770ba28e15f14efacfab1eb7ab","item_hash_version":2}
