{"ts":"2026-07-31T06:38:36.725Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_instance":"66076e2c28cfb4fafc6fb839","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-rl-keet"},{"op":"add","path":"/metadata/title","value":"pm rl invalidate: transitive result invalidation over the pm graph"},{"op":"add","path":"/metadata/description","value":"Given an environment or benchmark version, list every EvalResult, Transfer and Run transitively invalidated by changing it. This is the question that costs programmes weeks and that nothing else records, and it is a reachability query over dependencies pm already stores."},{"op":"add","path":"/metadata/type","value":"Feature"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-07-31T06:38:36.725Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-07-31T06:38:36.725Z"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Returns exactly the transitive set with no false positives and no omissions on a fixture with several generations of environment versions; reports the path by which each result is reached"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"8df9015634559430907d7f35c4402ec14ffb2a5f6ecc6b4aeb02016a31670ca2","message":""}
