    scope: project
    timeout_seconds: 300
    pm_context_mode: none
    workspace_context_mode: snapshot
    provenance:
      author: codex-agent
      created_at: "2026-10-21T15:03:31.178Z"
      source_kind: local_mutation
      source_ref: feat/recursive-training-generations
